# =============================================================================
# morx-collector configuration
#
# Copy to `.env` and edit:  cp .env.example .env
#
# Every value is optional and falls back to the default shown, so pointing this
# at a different device means changing one line.
# =============================================================================

# -----------------------------------------------------------------------------
# Device(s) — pick ONE of the two styles below.
#
#   1. Single device: set MORX_DEVICE_HOST (plus any overrides).
#   2. Many devices:  set MORX_DEVICES_FILE to a JSON inventory
#                     (see config/devices.example.json).
#
# If MORX_DEVICES_FILE is set it wins and the MORX_DEVICE_* values are ignored.
# -----------------------------------------------------------------------------
MORX_DEVICE_HOST=192.168.77.201
MORX_DEVICE_PORT=4370

# Friendly name used in logs and stored on every row. Defaults to the host.
MORX_DEVICE_NAME=

# Comm password configured on the device (0 = none).
MORX_DEVICE_PASSWORD=0

# Socket timeout in seconds.
MORX_DEVICE_TIMEOUT=10

# Some older/cheaper clones only speak UDP.
MORX_DEVICE_FORCE_UDP=false

# Skip the ICMP reachability probe — needed when ping is firewalled, or when
# the process can't open raw sockets.
MORX_DEVICE_OMIT_PING=false

# Text encoding the firmware uses for names. latin-1 / gbk are common on
# non-English units; wrong values show up as mojibake in employee names.
MORX_DEVICE_ENCODING=UTF-8

# MORX_DEVICES_FILE=config/devices.json

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# csv | sqlite
MORX_STORAGE_BACKEND=csv
MORX_DATA_DIR=data
MORX_SQLITE_PATH=data/attendance.db

# -----------------------------------------------------------------------------
# Collection behaviour
# -----------------------------------------------------------------------------
# Pull the device's stored backlog on every (re)connect. Writes are idempotent,
# so leaving this on is what backfills punches missed while offline.
MORX_SYNC_HISTORY=true

# Seconds between live-capture socket reads. Also how quickly the process
# notices a shutdown signal.
MORX_LIVE_POLL_INTERVAL=10

# Log an "alive" line after this many idle seconds (0 disables).
MORX_HEARTBEAT_INTERVAL=300

# Reconnect backoff: exponential from min to max, with jitter.
MORX_RECONNECT_MIN_DELAY=2
MORX_RECONNECT_MAX_DELAY=60

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
MORX_LOG_LEVEL=INFO
# text | json
MORX_LOG_FORMAT=text
# Leave empty to log to stderr only (correct for systemd and Docker).
MORX_LOG_FILE=
