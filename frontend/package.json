{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "qa:build": "vite build --config qa/vite.qa.config.js",
    "qa:capture": "bash qa/capture.sh",
    "qa:scroll": "node qa/shell-scroll.test.mjs",
    "qa:safe-area": "node qa/safe-area.test.mjs",
    "qa:responsive": "npm run qa:build && npm run qa:scroll && npm run qa:safe-area && npm run qa:capture"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
