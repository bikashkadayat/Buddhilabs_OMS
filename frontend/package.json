    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "vite": "^8.0.1",
    "vitest": "^2.1.9"
  },
  "//engines": "vite 8 builds with rolldown, whose platform-native binding ships as an optional dependency. npm silently SKIPS optional deps when the running Node fails an engine check, which leaves `vitest` and `vite build` failing with 'Cannot find module @rolldown/binding-*'. Node >= 20.19 is therefore a hard requirement, not a preference — install under it and rolldown resolves the correct binding (glibc or musl) on its own.",
  "engines": {
    "node": ">=20.19"
  }
}
