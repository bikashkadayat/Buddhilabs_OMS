# Environment configuration template. Copy to `.env` and fill in real values.
# `.env` is gitignored - never commit real secrets.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-generate-a-random-key
# "False" in production. When False the app fails fast if any secret is missing.
DJANGO_DEBUG=False
# Explicit host list (no "*") is REQUIRED when DEBUG is False.
# Prod: set this to your domain, e.g. nif.example.com (the prod stack appends
# localhost/127.0.0.1 automatically for the in-container healthcheck).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# NOTE: the prod stack no longer terminates TLS itself. The container nginx
# serves plain HTTP on 127.0.0.1:8080; the HOST nginx (or Cloudflare) terminates
# TLS and proxies to it — see docs/DEPLOYMENT.md. There is no SITE_DOMAIN var.
#
# Host bind for the web container's :80. Default 127.0.0.1:8080. Change the port
# if 8080 is already taken on the VPS, or set to just "80" to expose it directly
# (e.g. behind Cloudflare) instead of only to a local host proxy.
# WEB_BIND=127.0.0.1:8080

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_ENGINE=postgresql
DATABASE_NAME=leave_system
DATABASE_USER=leave_user
DATABASE_PASSWORD=change-me-strong-db-password
# DATABASE_HOST / DATABASE_PORT are set per environment (db service, localhost).
# DATABASE_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# HTTPS / security
# The prod stack (docker-compose.prod.yml) defaults these ON — correct when a
# TLS-terminating host nginx / Cloudflare sits in front and forwards
# X-Forwarded-Proto: https. Override to False only for a plain-HTTP local test.
# The dev stack (docker-compose.yml) already forces them off for http://localhost.
# ---------------------------------------------------------------------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# CSRF origins for admin/session over HTTPS behind your reverse proxy. REQUIRED
# in prod (the prod stack refuses to start without it).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://nif.example.com

# ---------------------------------------------------------------------------
# CORS (usually unused: frontend calls the backend same-origin via the reverse
# proxy). Only needed if the frontend uses an absolute cross-origin API URL.
# ---------------------------------------------------------------------------
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://nif.example.com

# ---------------------------------------------------------------------------
# Public URLs (email action links + PDF QR verification)
# ---------------------------------------------------------------------------
# FRONTEND_URL=https://nif.example.com
# SITE_URL=https://nif.example.com

# ---------------------------------------------------------------------------
# Multi-tenancy (Phase S1 - FOUNDATION ONLY)
# ---------------------------------------------------------------------------
# TENANCY_ENABLED is the master switch and it is OFF by default. LEAVE IT OFF.
#
# With it off, the tenant middleware resolves Host -> Organization, attaches it
# to the request, and REFUSES NOTHING: no 403 on a host/token mismatch, no 402
# on an expired subscription, no rejection of an unknown host. An unresolved
# host falls back to the single existing Organization, which is why NIF keeps
# working when reached on an IP, on localhost, or through a Docker service name.
#
# Turning it on BEFORE the Phase S2/S3 isolation work (organization_id columns,
# tenant-scoped managers, PostgreSQL RLS) would start enforcing a boundary that
# nothing below it implements yet. Flip it only when the two-tenant conformance
# suite is green.
# TENANCY_ENABLED=0

# The domain tenant subdomains hang off: nif.<TENANCY_BASE_DOMAIN>.
# Needs wildcard DNS (*.platform.com) and a wildcard TLS certificate.
# TENANCY_BASE_DOMAIN=platform.com

# Hostnames that address the PLATFORM CONSOLE rather than any tenant.
# Comma-separated. A tenant slug can never shadow one of these - the reserved
# list in tenancy/slugs.py is the other half of that guarantee.
#
# REQUIRED ONCE TENANCY_ENABLED=1 (Phase S6). The console refuses to answer on
# a tenant host, so with this unset there is no host it will answer on at all.
# That refusal is deliberate: a platform session established on a customer's
# subdomain is one XSS away from being a platform session the customer can
# drive.
#
# Point this hostname at the same application; nothing separate is deployed.
# TENANCY_PLATFORM_HOSTS=admin.platform.com

# ---------------------------------------------------------------------------
# PostgreSQL row-level security (Phase S5/S6)
# ---------------------------------------------------------------------------
# With this on, every tenant table is governed by a database policy keyed on
# `app.current_org`, which the request middleware binds per transaction. Forget
# a filter in application code and the DATABASE returns zero rows rather than
# another tenant's.
#
# THREE THINGS MUST ALL BE TRUE, or it is decorative:
#
#   1. PostgreSQL. The setting refuses to boot on SQLite rather than pretend.
#   2. The application connects as a NOSUPERUSER, NOBYPASSRLS role that does
#      NOT own the tables (see tenancy/rls.py for the three roles).
#   3. ATOMIC_REQUESTS, which this setting switches on itself -- SET LOCAL
#      needs a transaction to be local to.
#
# Migrations run as the migration role, which DOES bypass RLS, because a
# backfill is a cross-tenant rewrite by definition.
# TENANCY_RLS_ENABLED=0

# Slug an unresolved host falls back to while TENANCY_ENABLED=0. Empty means
# "the only organization that exists", which is correct for a single-tenant
# deployment and deliberately refuses to guess once a second tenant exists.
# TENANCY_DEFAULT_SLUG=nif

# ---------------------------------------------------------------------------
# Email (defaults to console backend - configure SMTP to actually send mail)
# ---------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@your-domain

# ---------------------------------------------------------------------------
# Object storage for media (optional; default stores on the container filesystem).
# Requires: pip install "django-storages[boto3]"
# ---------------------------------------------------------------------------
# USE_S3=True
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Gunicorn / logging
# ---------------------------------------------------------------------------
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
# DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Attendance — office geofence & location capture
#
# IMPORTANT: browsers only expose location over HTTPS (a "secure context"). On
# plain HTTP the check-in still succeeds but records NO location at all, so the
# site must be served over TLS for any of this to work.
#
# With the office coordinates set, every check-in/out stores its distance from
# the office and the UI shows "At Office" or "340 m away". Leave lat/lng empty
# to disable the geofence (coordinates are still captured and reverse-geocoded).
# Get the coordinates by right-clicking the office in Google Maps -> the first
# menu entry is "lat, lng"; paste the two numbers below.
# ---------------------------------------------------------------------------
# ATTENDANCE_OFFICE_NAME=NIF Office
# ATTENDANCE_OFFICE_LAT=27.712345
# ATTENDANCE_OFFICE_LNG=85.312345
# ATTENDANCE_OFFICE_RADIUS_M=150
# Fixes worse than this (metres) are shown as "approximate" rather than exact.
# ATTENDANCE_MAX_ACCURACY_M=100
# Require a browser location to check in/out (default 1/on) so every attendance
# record carries a location for HR/Admin. IMPORTANT: browser geolocation only
# works over HTTPS (or localhost) — with this on, staff on plain HTTP or a
# desktop that can't get a fix CANNOT check in. Set to 0 to allow check-ins
# without a location (optional capture) until HTTPS is live.
# ATTENDANCE_REQUIRE_LOCATION=1

# Reverse geocoding (coordinates -> place name). Set to 0 to store coordinates
# only. The public Nominatim server is rate-limited to ~1 req/sec, which is not
# enough for a morning check-in rush: either self-host it and set
# ATTENDANCE_NOMINATIM_URL, or set a Google Geocoding key (preferred when
# present — much better building/POI names in Nepal).
# ATTENDANCE_REVERSE_GEOCODE=1
# ATTENDANCE_NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# ATTENDANCE_GEOCODE_USER_AGENT=NIF-OfficeManagement/1.0 (you@your-domain)
# ATTENDANCE_GOOGLE_GEOCODE_KEY=
# ===========================================================================
# Phase 11 — production hardening. Read the first block before go-live.
# ===========================================================================

# ---------------------------------------------------------------------------
# Trusted proxies (audit finding H1) — VERIFY THIS ONE, DO NOT GUESS
# ---------------------------------------------------------------------------
# How many proxies WE control sit in front of Django. Everything further left in
# X-Forwarded-For is caller-supplied and must not be trusted.
#
#   0 = Django directly exposed
#   1 = one reverse proxy
#   2 = Cloudflare + ingress nginx  (the documented production topology)
#
# Getting this wrong is NOT symmetrical:
#   too LOW  -> every client shares one rate-limit bucket. Too strict, visible,
#               harmless.
#   too HIGH -> caller-supplied text is trusted as the client IP, which IS the
#               rate-limit bypass this setting exists to close.
#
# Set it from evidence:
#   docker compose exec backend python manage.py verify_proxy_config --from-audit
TRUSTED_PROXY_DEPTH=2

# ---------------------------------------------------------------------------
# Login brute-force protection (audit finding H2)
# ---------------------------------------------------------------------------
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW=900
LOGIN_LOCKOUT_SECONDS=900
# False keeps throttling and auditing but never locks an account (the
# alerting-only posture), if locking out a director before a board meeting is a
# worse outcome for you than a slow brute force.
LOGIN_LOCKOUT_ENABLED=True

# ---------------------------------------------------------------------------
# Backups (audit findings H3 + H4) — REQUIRED
# ---------------------------------------------------------------------------
# The cron container now REFUSES TO START without the key: it was previously
# optional here and mandatory in backup.sh, so an unset key meant the backup
# aborted every night in silence.
BACKUP_ENCRYPTION_KEY=change-me-long-random-passphrase
# Set exactly ONE off-host target. A local-only copy is not a backup, and
# BACKUP_REQUIRE_OFFHOST=1 makes the job fail rather than pretend otherwise.
BACKUP_S3_BUCKET=
BACKUP_RSYNC_TARGET=
BACKUP_REQUIRE_OFFHOST=1
BACKUP_RETENTION_DAYS=14
# Generated reports are regenerable and purged after 30 days anyway, so they are
# excluded from the media archive to keep it small.
BACKUP_MEDIA_INCLUDE_REPORTS=0

# ---------------------------------------------------------------------------
# Monitoring & alerting
# ---------------------------------------------------------------------------
# With neither set, alerts are still evaluated and RECORDED — but nobody is
# told, and /monitoring shows a banner saying exactly that.
ALERT_EMAILS=ops@nif.example.org
ALERT_WEBHOOK_URL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Attendance policy — PIN THESE before go-live
# ---------------------------------------------------------------------------
# Left empty, ATTENDANCE_POLICY_GO_LIVE defaults to the date the migration ran,
# which differs between staging and production and makes history irreproducible.
ATTENDANCE_TRACKING_START=
ATTENDANCE_POLICY_GO_LIVE=

# ---------------------------------------------------------------------------
# Biometric terminal (Phase 12) — the in-OMS collector
# ---------------------------------------------------------------------------
# `manage.py device_sync` pulls the roster and attendance log from the terminal
# directly, on a 5-minute cron. There is no separate collector process; the
# terminal's LAN address and timezone live on the BiometricDevice row, not here.
#
# The terminal is the source of truth for employee identity. Nothing in the OMS
# renumbers a device user ID — see docs/PHASE_12_GO_LIVE.md §1A.
#
# COMM key: 0 unless one is set on the terminal (Comm > Security > COMM Key).
# Wrong or missing when the device has one, and the sync fails loudly at
# connect — it does not silently collect nothing.
BIOMETRIC_DEVICE_COMM_KEY=0
# Seconds. A full attendance-log transfer on a busy terminal is slow, and a
# timeout mid-transfer costs a whole retry cycle.
BIOMETRIC_DEVICE_TIMEOUT=20

# --- PUSH / iClock (the path 192.168.77.201 actually uses) -------------------
# The terminal is a ZKTeco ZLM60, which dials OUT to the OMS over plain HTTP
# rather than answering SDK calls. It identifies itself with ?SN=<serial> and
# nothing else — the protocol has no authentication and the firmware cannot be
# made to send a key.
#
# So devices are allow-listed by serial on BiometricDevice.serial_number, and
# this narrows it further to known source IPs. Empty accepts any source whose
# serial is registered. SET THIS if /iclock/ could be reached from outside the
# LAN; the network is the real security boundary here.
BIOMETRIC_PUSH_ALLOWED_IPS=192.168.77.201

# ---------------------------------------------------------------------------
# Other Phase 11 tuning
# ---------------------------------------------------------------------------
# Reduced from 3600 (audit finding M7). Signed links are followed within seconds
# of being issued and are now bound to the requesting user, so an hour of
# validity bought nothing but exposure.
MEDIA_SIGNED_URL_TTL=300

# Secrets checklist before go-live:
#   [ ] DJANGO_SECRET_KEY, DATABASE_PASSWORD and BACKUP_ENCRYPTION_KEY are in a
#       password manager, recoverable by a SECOND person. A backup encrypted
#       with a key only one person holds is one bus away from being no backup.

# ---------------------------------------------------------------------------
# Biometric attendance (morx) — live check-in/out from the ZK terminal
#
# Two prod services (docker-compose.prod.yml): `biometric` serves the read-only
# dashboard the admin embeds; `biometric-collector` (morx run) connects to the
# terminal and streams punches into the shared biometric_data volume, which the
# dashboard reads. The dev stack (docker-compose.yml) runs the same two on
# localhost:8765. Device settings below are read by the collector.
# ---------------------------------------------------------------------------
#
# REQUIRED in prod. Public https URL of the biometric dashboard — baked into the
# SPA build so its iframe can load it. morx serves from / with absolute
# /assets + /api paths, so it CANNOT share the main app's origin: give it its
# own hostname routed by the shared ingress to nif-biometric:8765 (see
# deploy/nif-biometric.conf). Dev leaves this unset (defaults to localhost:8765).
# WARNING: the dashboard has no auth of its own — protect this hostname at the
# ingress (Cloudflare Access / IP allowlist / basic auth).
# VITE_BIOMETRIC_URL=https://attendance.your-domain
#
# REQUIRED for the collector. IP/host of the biometric terminal on the LAN. The
# production host must be able to reach it (same network or a VPN route).
# MORX_DEVICE_HOST=192.168.77.201
#
# Optional device tuning (defaults shown). Read the serial/settings from the
# terminal's on-screen menu; PASSWORD is the device comm key (0 = none).
# MORX_DEVICE_PORT=4370
# MORX_DEVICE_PASSWORD=0
# MORX_DEVICE_TIMEOUT=10
# MORX_DEVICE_FORCE_UDP=false
# The collector pings the device before connecting — set true if ICMP is blocked
# (e.g. from a bridged container) or the connect fails with "can't reach device".
# MORX_DEVICE_OMIT_PING=false
#
# Where punches are stored inside the container (data/ on the biometric_data
# volume). csv is the default; sqlite is also supported.
# MORX_STORAGE_BACKEND=csv
