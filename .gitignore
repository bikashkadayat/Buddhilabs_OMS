############################################
# Added 2026-08-06 — local dev artefacts
############################################

# Virtual environments. The existing `venv/` rules do NOT match a leading dot,
# so backend/.venv (326 MB) was staged for commit.
.venv/
*/.venv/
env/
.python-version

# Linter / tool caches
.ruff_cache/
.mypy_cache/
.tox/

# Claude Code local settings (machine-specific, may contain local paths)
.claude/settings.local.json

# Biometric exports. `roster_report --csv` and the report builders write REAL
# employee names and attendance to disk — these must never reach a remote.
mapping.csv
*_report_*.csv
attendance_vs_leave_*.csv
overtime_summary_*.csv
backend/exports/

# Live biometric collector data (PII: real employee names + every punch).
# Written continuously by `morx run`, so it also churns git history and causes
# merge conflicts. Production reads a named Docker volume, not these files, so
# they never need to be in the repo. (Already-tracked copies were untracked with
# `git rm --cached`; the history still holds the old snapshots.)
biometric_attendance_nif/data/attendance.csv
biometric_attendance_nif/data/employees.csv
biometric_attendance_nif/data/*.db

# Backup artefacts
*.dump
*.sql.gz
*.tar.gz.gpg
backups/

# Patch/merge leftovers
*.orig
*.rej

# Visual QA harness output (Phase 46/47). `frontend/dist-qa` is a build; `frontend/qa-out`
# holds 52 screenshots, the generated PDF/Excel exports and the overflow findings. All of
# it is regenerated by `npm run qa:build && npm run qa:capture` plus the `qa` pytest
# marker, and none of it should be committed.
frontend/dist-qa/
frontend/qa-out/
